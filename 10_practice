#include <iostream>
#include <fstream>
#include <string>
#include <regex>
#include <vector>
#include <iomanip>
#include <windows.h>

using namespace std;

// Структура для удобного хранения данных студента
struct Student {
    string original_line;
    string fio;
    string birth_date;
    double height; // в метрах
    double weight; // в кг
    double bmi;    // Индекс массы тела
    bool is_female;
};

int main() {
    // Настройка кодировки для корректного вывода кириллицы в консоли Windows
    SetConsoleCP(65001);
SetConsoleOutputCP(65001);


    ifstream file("students.txt");
    if (!file.is_open()) {
        cout << "Не удалось открыть файл students.txt" << endl;
        return 1;
    }

    string line;
    // Регулярное выражение для разбора строки с учетом возможных пробелов:
    // Группа 1: ФИО, Группа 2: Дата, Группа 3: Рост, Группа 4: Вес
    regex student_regex(R"(^\s*([^;]+?)\s*;\s*(\d{4}-\d{2}-\d{2})\s*;\s*(\d+)\s*;\s*(\d+)\s*$)");

    // Регулярное выражение для определения девушек по отчеству (заканчивается на "на")
    regex female_regex(R"(.+на\s*$)");

    vector<Student> students;

    // Пропускаем первую строчку (заголовок), если она совпадает с текстовым шаблоном заголовка
    while (getline(file, line)) {
        if (line.empty()) continue;

        smatch match;
        if (regex_match(line, match, student_regex)) {
            Student s;
            s.original_line = line;
            s.fio = match[1].str();
            s.birth_date = match[2].str();
            s.height = stod(match[3].str()) / 100.0; // переводим см в метры
            s.weight = stod(match[4].str());
            s.bmi = s.weight / (s.height * s.height); // BMI = вес / рост²
            s.is_female = regex_match(s.fio, female_regex);

            students.push_back(s);
        }
    }
    file.close();

    if (students.empty()) {
        cout << "Данные о студентах не найдены." << endl;
        return 0;
    }


    // --- Задание 1: Самая молодая студентка-девушка ---
    cout << "=========================================================" << endl;
    cout << "ЗАДАНИЕ 1: Самая молодая студентка-девушка" << endl;
    cout << "=========================================================" << endl;

    Student youngest_female;
    bool female_found = false;

    for (const auto& s : students) {
        if (s.is_female) {
            // В формате ГГГГ-ММ-ДД более поздняя дата (младший возраст) лексикографически больше
            if (!female_found || s.birth_date > youngest_female.birth_date) {
                youngest_female = s;
                female_found = true;
            }
        }
    }

    if (female_found) {
        cout << "ФИО: " << youngest_female.fio << " (Дата рождения: " << youngest_female.birth_date << ")" << endl;
    } else {
        cout << "Девушки в списке не найдены." << endl;
    }
    cout << endl;

    // --- Задание 2: Вывод во всех строках только колонок «ФИО» и «вес» ---
    cout << "=========================================================" << endl;
    cout << "ЗАДАНИЕ 2: Колонки \"ФИО\" и \"вес\" для всех студентов" << endl;
    cout << "=========================================================" << endl;
    cout << left << setw(35) << "ФИО" << " | " << "Вес (кг)" << endl;
    cout << string(50, '-') << endl;
    for (const auto& s : students) {
        cout << left << setw(35) << s.fio << " | " << s.weight << endl;
    }
    cout << endl;


    // --- Задание 3: Строка с максимальным ИМТ (BMI) ---
    cout << "=========================================================" << endl;
    cout << "ЗАДАНИЕ 3: Студент с максимальным индексом массы тела" << endl;
    cout << "=========================================================" << endl;

    Student max_bmi_student = students[0];
    for (const auto& s : students) {
        if (s.bmi > max_bmi_student.bmi) {
            max_bmi_student = s;
        }
    }

    cout << "ФИО: " << max_bmi_student.fio << " | ИМТ (BMI): " << fixed << setprecision(2) << max_bmi_student.bmi << endl;
    cout << "=========================================================" << endl;

    return 0;
}
